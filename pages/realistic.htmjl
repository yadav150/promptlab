    <!-- ===== MAIN ===== -->
    <main class="main" role="main">
        <div class="container">

            <!-- Category Header -->
            <section class="hero" style="border-bottom-color:var(--color-border);">
                <h1 style="font-size:var(--font-3xl);">
                    <span class="icon" style="display:inline-block; margin-right:var(--spacing-sm);" aria-hidden="true">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <circle cx="12" cy="12" r="4" />
                            <line x1="12" y1="2" x2="12" y2="4" />
                            <line x1="12" y1="20" x2="12" y2="22" />
                            <line x1="2" y1="12" x2="4" y2="12" />
                            <line x1="20" y1="12" x2="22" y2="12" />
                        </svg>
                    </span>
                    Realistic Prompts
                </h1>
                <p>Ultra-realistic prompts for lifelike portraits, nature, and everyday scenes.</p>
            </section>

            <!-- Prompt Grid with 18 cards -->
            <section>
                <div class="prompt-grid">

                    <!-- ===== PAGE 1 (Cards 1-6) ===== -->
                    <!-- Card 1 -->
                    <div class="prompt-card">
                        <div class="image-placeholder">
                            <span class="placeholder-icon" aria-hidden="true">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                    <circle cx="8.5" cy="8.5" r="1.5" />
                                    <polyline points="21 15 16 10 5 21" />
                                </svg>
                            </span>
                            <span class="placeholder-label">Image</span>
                        </div>
                        <div class="body">
                            <div class="prompt-text">
                                <span class="label">Prompt</span>
                                "Hyper-realistic portrait of an elderly woman with weathered skin, deep wrinkles, silver hair, soft window light, incredible texture detail, 8k, photorealistic"
                            </div>
                            <div class="actions">
                                <button class="btn btn-sm btn-copy">Copy</button>
                                <button class="btn btn-sm btn-share">Share</button>
                            </div>
                        </div>
                    </div>

                    <!-- Card 2 -->
